# Focus window
hyper - h: yabai -m window --focus west;
hyper - j: yabai -m window --focus south;
hyper - k: yabai -m window --focus north;
hyper - l: yabai -m window --focus east;
hyper - m: yabai -m window --minimize; yabai -m window --focus mouse;

# Move window
hyper - f: yabai -m window --toggle zoom-fullscreen;

# Modify window
hyper - p: yabai -m window --toggle float;
hyper - g: yabai -m window --toggle sticky;

# Reset window spacing
hyper - b: yabai -m space --balance;

# Rotate tree 180
hyper - r: yabai -m space --rotate 180;

# hyper - g: yabai -m window --ratio abs:0.60;

hyper - q: yabai -m space --focus prev || yabai -m space --focus last;
hyper - e: yabai -m space --focus next || yabai -m space --focus first;

hyper - i: yabai -m space --create;
hyper - o: yabai -m space --destroy;

hyper - return: open -na /Applications/WezTerm.app
alt - space: open -na /Users/ryanloh/Applications/Gemini.app

ctrl + alt + cmd - r: yabai --restart-service
ctrl + alt + cmd - h: skhd --restart-service

hyper - 1: yabai -m space --focus 1;
hyper - 2: yabai -m space --focus 2;
hyper - 3: yabai -m space --focus 3;
